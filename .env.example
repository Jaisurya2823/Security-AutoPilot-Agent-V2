# Groq (LLM inference)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Supply chain agent (public API, no key needed)
OSV_API_URL=https://api.osv.dev/v1

# Threat intel: real live IP blocklist feed (public, no key needed)
IOC_FEED_URL=https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset
IOC_FEED_CACHE_SECONDS=21600

# Live NVD CVE lookups (public, no key needed, opt-in since it adds latency)
ENABLE_LIVE_CVE_LOOKUP=false

# Remediation execution: point this at YOUR real SOAR/firewall/EDR/IdP
# automation endpoint. Destructive actions (block_ip, quarantine_host,
# disable_account) and open_ticket only report success if a real POST
# to this URL returns 2xx. Leave blank to run fail-closed (every
# destructive action reports FAILED: not executed, never a fake
# success) — safe default for trying this out before wiring in a real
# integration.
REMEDIATION_WEBHOOK_URL=
REMEDIATION_WEBHOOK_TIMEOUT_SECONDS=10

# Agent behavior: alerts at or above this severity always require human
# approval, regardless of what action the model recommends or whether
# it thinks approval is needed. Independent of the action-type floor
# (DESTRUCTIVE_ACTIONS in src/models.py) — this one gates by how severe
# the alert is, not what the action is.
APPROVAL_SEVERITY_FLOOR=high

# Where paused human-gate decisions are checkpointed. SQLite-backed
# (not in-memory), so a pending approval survives a process restart as
# long as this file does.
GRAPH_CHECKPOINT_PATH=graph_checkpoints.sqlite3

# Repo ZIP upload safety limits (zip-bomb protection) — enforced by
# counting real bytes written during extraction, not the archive's own
# declared size.
MAX_ZIP_UNCOMPRESSED_BYTES=524288000
MAX_ZIP_FILE_COUNT=20000
